# WordPress / MySQL
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=changeme
WORDPRESS_DB_ROOT_PASSWORD=changeme_root

# n8n / Postgres
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme

# n8n app (login is managed via n8n's own user management, not env vars)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

DEEP_SEEK_API_KEY=changeme

# OpenRouter (used by the agentic product-photo search workflow's tool-calling loop)
OPENROUTER_API_KEY=changeme

# Amazon Product Advertising API 5.0 (used by "Source Product Photo" node to pull
# real catalog images tied to an ASIN instead of a general CC/wiki media search)
PAAPI_ACCESS_KEY=changeme
PAAPI_SECRET_KEY=changeme
PAAPI_PARTNER_TAG=changeme

# Review App - human approval gate before a generated review goes to WordPress
REVIEW_APP_PASSWORD=changeme
# Must match RGH_INGEST_API_KEY in wordpress/rgh-secrets.php (gitignored, not
# in this repo) - generate with `openssl rand -hex 32` and put the same value
# in both places.
LOCAL_WP_API_KEY=changeme
# Blank until rgh-ingest-api.php + its own rgh-secrets.php are deployed to the
# live site - "Publish to Production" errors clearly rather than silently
# no-op until this is set.
PROD_WP_API_KEY=